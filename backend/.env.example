# ============================================================================
# MOMENTUM BACKEND - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=3001

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================

# PRODUCTION (Vercel + Supabase): Use DATABASE_URL
# Copy from: Supabase Project → Settings → Database → Connection String (URI)
DATABASE_URL=postgresql://postgres.[PROJECT_ID].supabase.co:5432/postgres?sslmode=require

# LOCAL DEVELOPMENT ONLY: Use individual connection parameters
# (Only used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=momentum
# DB_USER=postgres
# DB_PASSWORD=your_local_password
# DB_SSL=false

# ============================================================================
# JWT CONFIGURATION (REQUIRED)
# ============================================================================
# Generate secure key: openssl rand -hex 32
JWT_SECRET=4bba6d15d409d73a2ae21b143d323a8dcafce9728b3b3931b279bba01d55bc6e
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================================
# CORS CONFIGURATION (REQUIRED)
# ============================================================================
# Vercel frontend URL or * for development
CORS_ORIGIN=https://momentum-frontend-ruddy.vercel.app,http://localhost:3000

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_VERSION=v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# ============================================================================
# FILE UPLOAD CONFIGURATION (Optional)
# ============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ============================================================================
# EXTERNAL SERVICES (Optional - for future use)
# ============================================================================

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Stripe (for payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SendGrid (for email)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@momentum.app

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_EMAIL_VERIFICATION=false
ENABLE_ANALYTICS=true

# ============================================================================
# ERROR MONITORING (Optional - for production)
# ============================================================================
# Get from: https://sentry.io
SENTRY_DSN=

# ============================================================================
# DEPLOYMENT INSTRUCTIONS
# ============================================================================
# 
# FOR VERCEL DEPLOYMENT:
# 1. Go to: https://vercel.com/nick-loves-projects/momentum-backend/settings/environment-variables
# 2. Add each variable from "REQUIRED" section above
# 3. Redeploy the project
# 4. Check deployment logs at: https://vercel.com/nick-loves-projects/momentum-backend/deployments
#
# TO TEST:
# - Health check: GET /health
# - Register: POST /api/auth/register with { email, password, name }
# - Login: POST /api/auth/login with { email, password }
#
