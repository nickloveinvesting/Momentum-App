# ============================================================================
# MOMENTUM BACKEND - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PRODUCTION: Use DATABASE_URL (Vercel + Supabase)
# Format: postgresql://user:password@host:port/db?sslmode=require
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres

# LOCAL DEVELOPMENT ONLY: Use individual connection parameters
# (Only used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=momentum
# DB_USER=postgres
# DB_PASSWORD=your_local_password
# DB_SSL=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# API Configuration
API_VERSION=v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# File Upload (if implementing file uploads)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# External Services (for future use)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SENDGRID_API_KEY=
EMAIL_FROM=noreply@momentum.app

# Feature Flags
ENABLE_EMAIL_VERIFICATION=false
ENABLE_ANALYTICS=true

# ============================================================================
# ERROR MONITORING
# ============================================================================

# ERROR MONITORING (Optional - for production error tracking)
SENTRY_DSN=https://[key]@sentry.io/[project-id]
